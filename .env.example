# Copy this file to .env.local and fill in the values. NEVER commit real values.
# Copiá este archivo a .env.local y completá los valores. NUNCA subas valores reales.
# Variable names are confirmed (Supabase commit). The values are validated in src/lib/env.ts.
# Los nombres de las variables están confirmados (commit de Supabase). Los valores se validan en src/lib/env.ts.

# Public site address / Dirección pública del sitio
NEXT_PUBLIC_SITE_URL=

# Supabase (public values, safe for the browser) / Supabase (valores públicos)
# The anon/publishable key only: a secret key is refused. / Solo la clave anon/publishable: una clave secreta se rechaza.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose to the browser or commit.
# SOLO SERVIDOR. Nunca exponer al navegador ni subir al repo.
SUPABASE_SERVICE_ROLE_KEY=
# Secret key used to build irreversible fingerprints (HMAC) / Clave para las huellas irreversibles (HMAC)
FINGERPRINT_HMAC_KEY=
# Secret key for the keyed hash of a visitor's origin (daily limit of the contact reveal). Random, 32 characters or more,
# different from every other key. / Clave secreta del hash con clave del origen del visitante (límite diario del revelado de
# contacto). Al azar, 32 caracteres o más, distinta de todas las demás.
RATE_LIMIT_HMAC_KEY=

# Cloudflare Turnstile (captcha of the contact reveal). The site key is public (browser); the secret key is SERVER ONLY.
# For local tests use Cloudflare's dummy keys (they accept anything, so the secret one is refused on the real site).
# Cloudflare Turnstile (captcha del revelado de contacto). La clave del sitio es pública (navegador); la secreta es SOLO SERVIDOR.
# Para pruebas locales usá las claves de prueba de Cloudflare (aceptan cualquier cosa; la secreta se rechaza en el sitio real).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Controller contact shown in legal pages / Contacto del titular que muestran las páginas legales
CONTROLLER_CONTACT_EMAIL=
